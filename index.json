{
  "schemaVersion": 1,
  "sources": [
    {
      "id": "admin-web",
      "file": "admin-web.yaml",
      "title": "ZrLog Admin Web API",
      "version": "4.0.0",
      "sha256": "42a8f91fb735d0b6a08d01b50569213117fe76fbba9cd1de466534dfd69d1ec0",
      "operations": [
        {
          "operationId": "triggerAssistantTasks",
          "method": "POST",
          "path": "/api/admin/assistant/trigger",
          "summary": "触发已到期的助手任务"
        },
        {
          "operationId": "listArticles",
          "method": "GET",
          "path": "/api/admin/article",
          "summary": "分页查询后台文章"
        },
        {
          "operationId": "getArticle",
          "method": "GET",
          "path": "/api/admin/article-edit",
          "summary": "读取完整文章快照"
        },
        {
          "operationId": "listCategories",
          "method": "GET",
          "path": "/api/admin/article-type",
          "summary": "查询全部文章分类"
        },
        {
          "operationId": "createCategory",
          "method": "POST",
          "path": "/api/admin/type/add",
          "summary": "创建文章分类"
        },
        {
          "operationId": "updateCategory",
          "method": "POST",
          "path": "/api/admin/type/update",
          "summary": "全量更新文章分类"
        },
        {
          "operationId": "listNavigation",
          "method": "GET",
          "path": "/api/admin/nav",
          "summary": "查询全部博客导航"
        },
        {
          "operationId": "createNavigation",
          "method": "POST",
          "path": "/api/admin/nav/add",
          "summary": "创建博客导航"
        },
        {
          "operationId": "updateNavigation",
          "method": "POST",
          "path": "/api/admin/nav/update",
          "summary": "全量更新博客导航"
        },
        {
          "operationId": "deleteNavigation",
          "method": "POST",
          "path": "/api/admin/nav/delete",
          "summary": "删除博客导航"
        },
        {
          "operationId": "createArticle",
          "method": "POST",
          "path": "/api/admin/article/create",
          "summary": "创建文章"
        },
        {
          "operationId": "updateArticle",
          "method": "POST",
          "path": "/api/admin/article/update",
          "summary": "全量更新文章"
        },
        {
          "operationId": "uploadAttachment",
          "method": "POST",
          "path": "/api/admin/upload",
          "summary": "上传通用附件"
        },
        {
          "operationId": "downloadTemporaryResource",
          "method": "GET",
          "path": "/api/admin/upload/resource",
          "summary": "下载已上传的临时资源"
        },
        {
          "operationId": "uploadTemplate",
          "method": "POST",
          "path": "/api/admin/template/upload",
          "summary": "上传或覆盖主题"
        },
        {
          "operationId": "createExternalNotification",
          "method": "POST",
          "path": "/api/webhook/message-center/notice",
          "summary": "发送消息中心通知"
        },
        {
          "operationId": "checkZrLogUpgrade",
          "method": "GET",
          "path": "/api/admin/upgrade",
          "summary": "检查 ZrLog 新版本及在线升级能力"
        },
        {
          "operationId": "getZrLogUpgradeNotice",
          "method": "GET",
          "path": "/api/admin/upgrade/notice",
          "summary": "获取 ZrLog 版本更新通知"
        },
        {
          "operationId": "executeZrLogUpgrade",
          "method": "POST",
          "path": "/api/admin/upgrade/doUpgrade",
          "summary": "执行 ZrLog 站点升级"
        }
      ]
    },
    {
      "id": "blog-web",
      "file": "blog-web.yaml",
      "title": "ZrLog Blog Public API",
      "version": "4.0.0",
      "sha256": "1ad7ada0b314c9d3fc6e87daf67846506b8c7827f72b76feb3e799f8affd4444",
      "operations": [
        {
          "operationId": "listPublicArticles",
          "method": "GET",
          "path": "/api/article",
          "summary": "查询公开文章列表"
        },
        {
          "operationId": "getPublicArticle",
          "method": "GET",
          "path": "/api/article/detail",
          "summary": "查询公开文章详情"
        },
        {
          "operationId": "listPublicArticleComments",
          "method": "GET",
          "path": "/api/article/comment",
          "summary": "查询文章公开评论"
        },
        {
          "operationId": "getBlogBootstrapData",
          "method": "GET",
          "path": "/api/cache",
          "summary": "查询博客初始化缓存"
        },
        {
          "operationId": "getBlogResource",
          "method": "GET",
          "path": "/api/public/blogResource",
          "summary": "查询博客前端资源配置"
        }
      ]
    },
    {
      "id": "plugin-core",
      "file": "plugin-core.yaml",
      "title": "ZrLog Plugin Core API",
      "version": "4.0.0",
      "sha256": "afbba0fc9b841636bf3c410a1051e19f60cc222db7ae1804a0bba8419539a661",
      "operations": [
        {
          "operationId": "installPlugin",
          "method": "POST",
          "path": "/api/admin/plugins/install",
          "summary": "从资源地址安装或更新插件"
        },
        {
          "operationId": "uploadPlugin",
          "method": "POST",
          "path": "/api/admin/plugins/upload",
          "summary": "上传并注册插件"
        }
      ]
    }
  ]
}
